{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-isolated",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:isolated", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "dev-3002",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_DIST_DIR=.next-isolated-3002", "npm", "run", "dev", "--", "--port", "3002"],
      "port": 3002
    }
  ]
}
